generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  firstName        String
  lastName         String
  email            String            @unique
  password         String?
  phone            String?
  role             Role              @default(TOURIST)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avatar           String?
  googleId         String?           @unique
  articles         Article[]
  bookings         Booking[]
  businesses       Business[]
  businessBookings BusinessBooking[]
  inquiries        BusinessInquiry[]
  notifications    Notification[]
  proposals        Proposal[]
  tripRequests     TripRequest[]
  partnerKyc       PartnerKyc?
}

model Destination {
  id              String        @id @default(uuid())
  name            String        @unique
  slug            String        @unique
  description     String
  bestSeason      String?
  state           String
  country         String
  coverImage      String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bufferArea      Float?
  bufferGates     Int?
  coreArea        Float?
  coreGates       Int?
  establishedYear Int?
  totalArea       Float?
  articles        Article[]
  bookings        Booking[]
  businesses      Business[]
  proposals       Proposal[]
  resorts         Resort[]
  tripRequests    TripRequest[]
}

model Resort {
  id            String      @id @default(uuid())
  name          String
  description   String
  address       String
  starRating    Int?
  amenities     String[]
  coverImage    String?
  images        String[]
  destinationId String
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  destination   Destination @relation(fields: [destinationId], references: [id])

  @@index([destinationId])
}

model TripRequest {
  id            String      @id @default(uuid())
  userId        String
  destinationId String
  travelerCount Int
  startDate     DateTime
  endDate       DateTime
  budget        String?
  preferences   String?
  notes         String?
  status        TripStatus  @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  booking       Booking?
  proposals     Proposal[]
  destination   Destination @relation(fields: [destinationId], references: [id])
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([destinationId])
  @@index([status])
}

model Proposal {
  id               String         @id @default(uuid())
  tripRequestId    String
  destinationId    String?
  resortIds        String[]
  numberOfNights   Int?
  dayWiseItinerary Json?
  activities       String[]
  totalPrice       Float?
  notes            String?
  expiryDate       DateTime?
  status           ProposalStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  acceptedAt       DateTime?
  businessIds      String[]
  changeRequest    String?
  content          String?
  safariNotes      String?
  sentAt           DateTime?
  userId           String
  booking          Booking?
  destination      Destination?   @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  tripRequest      TripRequest    @relation(fields: [tripRequestId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripRequestId])
  @@index([userId])
  @@index([status])
  @@index([destinationId])
}

model Booking {
  id            String        @id @default(uuid())
  userId        String
  tripRequestId String        @unique
  proposalId    String        @unique
  destinationId String
  travelerCount Int
  startDate     DateTime
  endDate       DateTime
  totalAmount   Float
  resortIds     String[]
  status        BookingStatus @default(CONFIRMED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  businessIds   String[]
  safariNotes   String?
  destination   Destination   @relation(fields: [destinationId], references: [id])
  proposal      Proposal      @relation(fields: [proposalId], references: [id])
  tripRequest   TripRequest   @relation(fields: [tripRequestId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([destinationId])
}

model Article {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  content       String
  featuredImage String?
  tags          String[]
  status        ArticleStatus @default(DRAFT)
  authorId      String
  destinationId String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  author        User          @relation(fields: [authorId], references: [id])
  destination   Destination?  @relation(fields: [destinationId], references: [id])

  @@index([status])
  @@index([authorId])
  @@index([destinationId])
}


model Notification {
  id          String           @id @default(uuid())
  userId      String
  title       String
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  referenceId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model PartnerKyc {
  id                 String     @id @default(uuid())
  userId             String     @unique
  doc1Type           String?
  doc1Number         String?
  doc2Type           String?
  doc2Number         String?
  aadhaarNumber      String?
  businessPan        String?
  gstin              String?
  idProofUrl         String?
  businessProofUrl   String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankIfsc           String?
  bankName           String?
  cancelledChequeUrl String?
  status             KycStatus  @default(KYC_UNSUBMITTED)
  rejectionReason    String?
  verifiedAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Business {
  id              String                   @id @default(uuid())
  name            String
  slug            String                   @unique
  type            BusinessType
  description     String
  coverImage      String?
  images          String[]
  contactEmail    String?
  contactPhone    String?
  address         String?
  starRating      Int?
  amenities       String[]
  metadata        Json?
  status          ApprovalStatus           @default(DRAFT)
  rejectionReason String?
  pendingUpdates  Json?
  verifiedAt      DateTime?
  destinationId   String?
  userId          String
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  destination     Destination?             @relation(fields: [destinationId], references: [id])
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings        BusinessBooking[]
  inquiries       BusinessInquiry[]
  rooms           BusinessRoom[]
  vehicles        BusinessVehicle[]
  equipment       BusinessEquipment[]
  inventoryBlocks BusinessInventoryBlock[]
  payouts         PayoutTransaction[]

  @@index([userId])
  @@index([status])
  @@index([type])
}

model BusinessInquiry {
  id            String        @id @default(uuid())
  businessId    String
  userId        String?
  customerName  String
  customerEmail String
  customerPhone String?
  message       String
  dateRequested DateTime?
  status        InquiryStatus @default(PENDING)
  slaDeadlineAt DateTime?
  escalatedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([status])
}

model BusinessRoom {
  id              String                   @id @default(uuid())
  businessId      String
  name            String
  description     String
  capacity        Int
  basePrice       Float
  totalInventory  Int                      @default(1)
  amenities       String[]
  images          String[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  bookings        BusinessBooking[]
  inventoryBlocks BusinessInventoryBlock[]
  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessVehicle {
  id                 String                   @id @default(uuid())
  businessId         String
  vehicleType        VehicleType
  modelName          String
  registrationNumber String
  driverName         String?
  driverPhone        String?
  maxPassengers      Int                      @default(6)
  supportedSlots     SafariSlot[]
  basePricePerSlot   Float
  images             String[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  business           Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings           BusinessBooking[]
  inventoryBlocks    BusinessInventoryBlock[]

  @@index([businessId])
}

model BusinessEquipment {
  id              String                   @id @default(uuid())
  businessId      String
  equipmentType   EquipmentType
  brandAndModel   String
  serialNumber    String?
  dailyRate       Float
  securityDeposit Float                    @default(0)
  condition       String                   @default("EXCELLENT")
  kitIncludes     String[]
  images          String[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings        BusinessBooking[]
  inventoryBlocks BusinessInventoryBlock[]

  @@index([businessId])
}

model BusinessInventoryBlock {
  id           String             @id @default(uuid())
  businessId   String
  roomId       String?
  vehicleId    String?
  equipmentId  String?
  startDate    DateTime
  endDate      DateTime
  slot         SafariSlot?
  unitsBlocked Int                @default(1)
  reason       BlockReason        @default(PROPERTY_MAINTENANCE)
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  room         BusinessRoom?      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  vehicle      BusinessVehicle?   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  equipment    BusinessEquipment? @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([roomId])
  @@index([vehicleId])
  @@index([equipmentId])
}

model PayoutTransaction {
  id             String          @id @default(uuid())
  businessId     String
  bookingId      String          @unique
  grossAmount    Float
  platformFee    Float
  netPayout      Float
  status         PayoutStatus    @default(HELD_IN_ESCROW)
  settlementDate DateTime?
  utrNumber      String?
  failureReason  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking        BusinessBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
}

model BusinessBooking {
  id                 String                @id @default(uuid())
  businessId         String
  roomId             String?
  vehicleId          String?
  equipmentId        String?
  slot               SafariSlot?
  userId             String
  guestName          String
  guestEmail         String
  guestPhone         String?
  specialRequests    String?
  startDate          DateTime
  endDate            DateTime
  travelerCount      Int
  totalAmount        Float
  platformFee        Float?
  status             BusinessBookingStatus @default(CONFIRMED)
  cancellationReason String?
  cancelledAt        DateTime?
  refundAmount       Float?
  refundStatus       String?
  payoutStatus       PayoutStatus          @default(HELD_IN_ESCROW)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  business           Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  room               BusinessRoom?         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  vehicle            BusinessVehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  equipment          BusinessEquipment?    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  payout             PayoutTransaction?

  @@index([businessId])
  @@index([roomId])
  @@index([vehicleId])
  @@index([equipmentId])
  @@index([userId])
  @@index([status])
}

enum Role {
  ADMIN
  TOURIST
  BUSINESS_PARTNER
}

enum KycStatus {
  KYC_UNSUBMITTED
  KYC_PENDING
  KYC_VERIFIED
  KYC_REJECTED
}

enum VehicleType {
  SAFARI_GYPSY_4X4
  INNOVA_TRANSFER
  CANTER_SAFARI
}

enum SafariSlot {
  MORNING_SAFARI
  AFTERNOON_SAFARI
  FULL_DAY_TRANSFER
}

enum EquipmentType {
  CAMERA_BODY
  TELEPHOTO_LENS
  ACCESSORY_KIT
}

enum BlockReason {
  PROPERTY_MAINTENANCE
  WALK_IN_OFFLINE_BOOKING
  MONSOON_CLOSURE
  PERSONAL_USE
}

enum PayoutStatus {
  HELD_IN_ESCROW
  PENDING_CLEARANCE
  PROCESSING
  PAID
  ON_HOLD
}

enum TripStatus {
  PENDING
  REVIEWING
  PROPOSAL_READY
  BOOKED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  DRAFT
  SENT
  CHANGE_REQUESTED
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  PROPOSAL_CREATED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  BOOKING_CONFIRMED
  BOOKING_COMPLETED
  SYSTEM_ANNOUNCEMENT
  BUSINESS_APPROVED
  BUSINESS_REJECTED
  BUSINESS_PENDING
  BUSINESS_SUSPENDED
  BUSINESS_INQUIRY_RECEIVED
  BUSINESS_BOOKING_CONFIRMED
  BUSINESS_BOOKING_CANCELLED
  BUSINESS_NEW_BOOKING_PARTNER
  BUSINESS_REVIEW_SUBMITTED
  KYC_SUBMITTED
  KYC_VERIFIED
  KYC_REJECTED
  BOOKING_CANCELLED_GUEST
  BOOKING_CANCELLED_PARTNER
  PAYOUT_CLEARED
  INQUIRY_ESCALATED
}

enum ApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessType {
  RESORT
  TAXI
  CAMERA_RENTAL
}

enum InquiryStatus {
  PENDING
  RESPONDED
  CLOSED
  ESCALATED
  EXPIRED
}

enum BusinessBookingStatus {
  CONFIRMED
  CANCELLED
  CANCELLED_BY_GUEST
  CANCELLED_BY_PARTNER
  COMPLETED
}
